{
  "name": "relaton-ts",
  "version": "0.1.0",
  "description": "TypeScript implementation of the Relaton bibliographic model, generated from the lutaml-model definitions in relaton/relaton",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "export:schema": "bundle exec ruby tools/export_schema.rb",
    "generate": "tsx tools/codegen.ts",
    "build": "tsc",
    "test": "vitest run"
  },
  "keywords": ["relaton", "bibliographic", "standards", "lutaml"],
  "license": "BSD-2-Clause",
  "dependencies": {
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
